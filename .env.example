# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string (Neon, Supabase, RDS, etc.)
DATABASE_URL=

# `openssl rand -base64 32`
NEXTAUTH_SECRET=
# Full production URL, no trailing slash, e.g. https://storiesbyakshat.com
NEXTAUTH_URL=
# Same as NEXTAUTH_URL — used for absolute links, sitemap, OG tags
NEXT_PUBLIC_SITE_URL=

# Gmail account used to send contact-form notifications/auto-replies.
# GMAIL_APP_PASSWORD must be a 16-character Google App Password, not the account password
# (requires 2-Step Verification enabled: https://myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Inbox that receives new-contact-message notifications (usually same as GMAIL_USER)
ADMIN_EMAIL=

# Cloudinary — used for all gallery/editorial/blog image & video uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
